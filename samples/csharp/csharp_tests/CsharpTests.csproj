<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests del runtime C# SIN NinjaTrader y SIN dependencias NuGet.
    Compila los .cs publicados en samples/csharp/ y los ejercita con un runner
    mínimo (Program.cs). Ejecutar desde samples/csharp/csharp_tests:

        dotnet run -c Release

    Devuelve código de salida != 0 si algún test falla.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CsharpTests</AssemblyName>
    <RootNamespace>HFT_BOT_ML.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\MiniJson.cs" />
    <Compile Include="..\HFT_BOT_ML_Common.cs" />
    <Compile Include="..\EnsembleDecisionEngine.cs" />
    <Compile Include="..\GlobalRiskCoordinator.cs" />
  </ItemGroup>

</Project>
